# =============================================================================
# 考研 AI 导学平台 · 仓库根 .gitignore
#
# 设计说明:
#   * 用「目录名」而不是写死路径(如 kaoyan-backend/venv/), 这样在任何子目录、
#     以后新增的模块目录里都生效, 组员不会因为路径不同而误提交。
#   * 真实配置(.env)绝不入库, 只提交 .env.example 模板。
#   * 拿不准时先 `git status` 看一眼再 add。
# =============================================================================

# ------------------------------ 环境变量与密钥 ------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
secrets/

# ------------------------------ Python ------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
wheels/
sdist/

# 虚拟环境
venv/
.venv/
env/
ENV/
.virtualenv/

# 测试与检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

# ------------------------------ Node / 前端 ------------------------------
node_modules/
.pnpm-store/
.yarn/
jspm_packages/
*.tsbuildinfo
.eslintcache
vite.config.ts.timestamp-*

# 构建产物
dist-ssr/
.output/
.vite/

# 依赖与调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 测试与覆盖率
coverage/
.nyc_output/
*.lcov

# ------------------------------ 编辑器与操作系统 ------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------ 运行时数据与日志 ------------------------------
*.log
logs/
data/
volumes/
uploads/
tmp/
temp/
*.sqlite
*.sqlite3
*.db
