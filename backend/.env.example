# =============================================================================
# 后端环境变量模板
#
# 用法:  copy .env.example .env      (Windows)
#        cp   .env.example .env      (macOS / Linux)
#
# 说明:  下面的默认值与根目录 docker-compose.yml 完全对应,
#        照抄即可连上容器里的 MySQL / Redis / MinIO, 无需改任何一项。
#        .env 已被 .gitignore 忽略, 不要提交到仓库。
# =============================================================================

# ---------------- MySQL ----------------
# 注意: docker-compose.yml 把容器 3306 映射到了宿主机 3307, 所以这里必须是 3307
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=kaoyan123
DB_NAME=kaoyan

# ---------------- Redis ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# compose 里的 Redis 未设密码, 留空即可; 若自己加了 requirepass 再填
REDIS_PASSWORD=

# ---------------- MinIO ----------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaoyan
# 是否使用 HTTPS(本地容器为 http, 保持 false)
MINIO_SECURE=false

# ---------------- 后端服务 ----------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
# 允许跨域的前端地址, 多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 运行环境 ----------------
# development / production。设为 production 时:
#   1) SECRET_KEY 若仍是仓库示例值, 后端拒绝启动(见 core/config.py: assert_secret_key_safe)
#   2) 邮件没配好时不再回显验证码到控制台, 直接报 503
APP_ENV=development

# ---------------- 认证 (JWT + AuthX) ----------------
# 下面这行已经为你生成了一枚随机密钥, 直接用即可;
# 若要重新生成:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意: 不要把这行提交到公开仓库, 泄露 = 任何人可伪造 token。
SECRET_KEY=s9RVWZ7L2apXvaIFtChOf_yy0P7FVLmluYXvAiXNFq_MVgv7Hb_Aewi4FMGTRzZ8
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# 密码策略(本次从 6 位提到 8 位, 并要求同时含字母和数字)
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=64

# 连续登录失败锁定: 默认失败 5 次锁 10 分钟
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_SECONDS=600

# ---------------- 授权 (RBAC) ----------------
# 关闭后缓存只存在进程内存, 多 worker 时权限变更可能不同步
REDIS_ENABLED=true
# 权限缓存有效期(秒), 角色/权限一变就整体失效, 不必等它过期
RBAC_CACHE_TTL=300
# 初始化数据: 首次启动时写入 16 条权限 + 2 个内置角色 + 初始管理员(幂等, 重复启动不会重复写)
AUTO_SEED=true

# ---------------- 邮箱验证码 ----------------
# 有效期 5 分钟, 最多试 5 次, 60 秒内不可重复发送
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_SECONDS=60

# ---------------- 邮件通道(方案 A: QQ 邮箱 SMTP over SSL 465) ----------------
# 开启步骤见 docs/改造说明.md 第七节, 核心是 QQ 邮箱设置里拿到的「授权码」
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=
# 注意: 这里填的是授权码, 不是 QQ 密码
MAIL_PASSWORD=
MAIL_FROM_NAME=考研AI导学平台
# 方案 E 兜底: MAIL_ENABLED=false 时把验证码打到控制台并回显给前端
# 仅在 APP_ENV 非 production 时生效
MAIL_FALLBACK_CONSOLE=true

# ---------------- 初始管理员(首次启动自动创建) ----------------
ADMIN_LOGIN_NAME=admin
ADMIN_INITIAL_PASSWORD=Admin@123456
ADMIN_EMAIL=admin@example.com

# ---------------- 数据库开关 ----------------
# 本地快速验证可用 SQLite; 生产 / docker-compose 走 MySQL 请设为 false
USE_SQLITE=false
