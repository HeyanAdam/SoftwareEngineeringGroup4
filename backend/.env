REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 真实发信: QQ 邮箱 SMTP (SSL 465, 授权码认证), 与 rjgc/config/mail.json 同一发件账号
# MAIL_PASSWORD 是 QQ 邮箱授权码(非登录密码); 含敏感凭据, 请勿上传仓库
MAIL_ENABLED=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=3897855794@qq.com
MAIL_PASSWORD=bwzkmcgihzkoccdd
MAIL_FROM_NAME=大学生考研AI导学系统
# 发信失败时降级为控制台回显验证码(仅开发环境生效)
MAIL_FALLBACK_CONSOLE=true
ADMIN_EMAIL=admin@kaoyan.local
ADMIN_LOGIN_NAME=admin
