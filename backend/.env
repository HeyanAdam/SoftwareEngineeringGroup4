APP_ENV=development
APP_NAME=考研AI导学平台
BACKEND_PORT=8001
SECRET_KEY=70ff16b9a16595c4d1f498b644da1810baab546972bf1cbe
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 本地调试: SQLite 单文件库, 无需 MySQL
USE_SQLITE=true
DB_ECHO=false

# 本地调试: 关闭 Redis, 自动退化到进程内内存存储
