# 后端本地开发参考配置 (Docker 环境由根目录 .env 注入, 无需本文件)
# 复制为 .env 后本机裸跑: cp .env.example .env
APP_ENV=local
DEBUG=true
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+aiomysql://sg4:sg4-change-me@127.0.0.1:3306/sg4?charset=utf8mb4
REDIS_URL=redis://:sg4-redis-change-me@127.0.0.1:6379/0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=sg4-minio
MINIO_SECRET_KEY=sg4-minio-change-me
MINIO_BUCKET=sg4-files
MINIO_SECURE=false

SECRET_KEY=dev-only-secret-key-please-change-me-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=1
SEED_DEMO_DATA=1
