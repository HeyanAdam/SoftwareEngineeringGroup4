# =============================================================================
# 复制为 .env 后即可 `docker compose up -d --build`
#   cp .env.example .env      (Windows: copy .env.example .env)
# 注意: .env 已被 .gitignore 忽略, 不要把真实密钥提交到仓库
# =============================================================================

# ---------- 项目 ----------
COMPOSE_PROJECT_NAME=sg4
TZ=Asia/Shanghai

# ---------- 端口映射 (宿主机端口) ----------
WEB_PORT=8080
# 仅 dev profile 使用: 容器化 vite 开发服务器端口
WEB_DEV_PORT=5173
API_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root-change-me
MYSQL_DATABASE=sg4
MYSQL_USER=sg4
MYSQL_PASSWORD=sg4-change-me

# ---------- Redis ----------
REDIS_PASSWORD=sg4-redis-change-me

# ---------- MinIO ----------
MINIO_ROOT_USER=sg4-minio
MINIO_ROOT_PASSWORD=sg4-minio-change-me
MINIO_BUCKET=sg4-files

# ---------- 后端 (FastAPI) ----------
# 容器内互访使用服务名; 本机裸跑后端时把 host 换成 127.0.0.1
DATABASE_URL=mysql+aiomysql://sg4:sg4-change-me@mysql:3306/sg4?charset=utf8mb4
REDIS_URL=redis://:sg4-redis-change-me@redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=sg4-minio
MINIO_SECRET_KEY=sg4-minio-change-me
MINIO_SECURE=false

# 生成方式: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-please-change-me-in-production-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS, 逗号分隔; 生产环境务必改成真实域名
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# 首次启动自动建表 (可选: 1=开启, 0=关闭, 生产建议 0 并用 alembic 迁移)
AUTO_CREATE_TABLES=1
# 首次启动写入演示账号 admin/Admin@123456 (1=开启)
SEED_DEMO_DATA=1
LOG_LEVEL=INFO

# ---------- 前端 ----------
# 浏览器侧访问 API 的地址 (nginx / vite 会代理 /api 与 /ws)
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
VITE_APP_TITLE=SG4 管理台
