# =============================================================================
# 后端环境变量模板
#
# 用法:  copy .env.example .env      (Windows)
#        cp   .env.example .env      (macOS / Linux)
#
# 说明:  下面的默认值与根目录 docker-compose.yml 完全对应,
#        照抄即可连上容器里的 MySQL / Redis / MinIO, 无需改任何一项。
#        .env 已被 .gitignore 忽略, 不要提交到仓库。
# =============================================================================

# ---------------- MySQL ----------------
# 注意: docker-compose.yml 把容器 3306 映射到了宿主机 3307, 所以这里必须是 3307
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=kaoyan123
DB_NAME=kaoyan

# ---------------- Redis ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# compose 里的 Redis 未设密码, 留空即可; 若自己加了 requirepass 再填
REDIS_PASSWORD=

# ---------------- MinIO ----------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaoyan
# 是否使用 HTTPS(本地容器为 http, 保持 false)
MINIO_SECURE=false

# ---------------- 后端服务 ----------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
# 允许跨域的前端地址, 多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 认证 (JWT) ----------------
# 生产环境务必替换成随机值, 生成方式:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-please-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
